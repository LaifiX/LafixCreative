---
// src/components/Blog.astro
import { getCollection } from 'astro:content';
import { marked } from 'marked';
import { Image } from 'astro:assets';

// 1. Načítame články
const allPosts = await getCollection('blog');

// 2. Zoradíme podľa dátumu (od najnovšieho)
const sortedPosts = allPosts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

// 3. Spracujeme dáta pre template
const blogPostsData = await Promise.all(sortedPosts.map(async (post, index) => {
  const contentHTML = await marked.parse(post.body);
  
  return {
    id: index,
    slug: post.slug,
    title: post.data.title,
    excerpt: post.data.excerpt,
    content: contentHTML,
    imageUrl: post.data.image,
    tags: post.data.tags,
    author: post.data.author,
    date: post.data.date.toLocaleDateString('sk-SK', {
      year: 'numeric',
      month: 'long',
      day: 'numeric'
    }),
  };
}));

// 4. Získame unikátne tagy
const allTags = ['Všetky', ...new Set(blogPostsData.flatMap(post => post.tags))];
---

<section id="blog" class="blog-section">
  <div class="container fade-in-section">
    
    <div id="blog-list-view">
        <h2 class="section-title neon-text-fuchsia">Z Môjho Blogu</h2>

        <div id="blog-filters" class="filters-wrapper">
            {allTags.map(tag => (
                <button class="filter-btn" data-tag={tag}>{tag}</button>
            ))}
        </div>

        <div class="blog-grid">
          {blogPostsData.map((post) => (
            <article class="blog-card" data-tags={post.tags.join(',')} data-id={post.id}>
              
              <div class="card-image-wrapper">
                <Image 
                  src={post.imageUrl}
                  alt={post.title}
                  class="blog-img-optimized"
                  width={600}
                  height={400}
                  loading="lazy"
                  decoding="async"
                />
              </div>

              <div class="card-content">
                <h3 class="card-title">{post.title}</h3>
                <p class="card-excerpt">{post.excerpt}</p>

                <div class="card-tags">
                  {post.tags.map(tag => (
                    <span class="tag">{tag}</span>
                  ))}
                </div>

                <div class="card-footer">
                  <a href={`/blog/${post.slug}`} class="read-more-link">
                    Čítať viac
                  </a>
                </div>
              </div>

            </article>
          ))}
        </div>
        
        <div id="blog-empty-state" class="empty-state" style="display: none;">
            <p>V tejto kategórii zatiaľ nie sú žiadne články.</p>
        </div>

        <div class="load-more-wrapper">
            <button id="blog-load-more" class="action-btn neon-button-cyan">Zobraziť Viac</button>
            <button id="blog-show-less" class="action-btn neon-button-fuchsia" style="display: none;">Schovať</button>
        </div>
    </div>

  </div>
</section>

<style>
  .blog-section {
    padding: 6rem 1.5rem;
    position: relative;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
  }

  /* ----- Nadpis sekcie ----- */
  .section-title {
    text-align: center;
    font-size: 2.5rem;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--fuchsia);
    margin-bottom: 3rem;
    text-shadow: 0 0 10px rgba(217, 70, 239, 0.5),
                 0 0 20px rgba(217, 70, 239, 0.3);
  }

  /* ----- Filter Buttons ----- */
  .filters-wrapper {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.6rem;
    margin-bottom: 3rem;
  }

  .filter-btn {
    padding: 0.6rem 1.5rem;
    font-size: 0.95rem;
    font-weight: 600;
    border-radius: 99px;
    border: 1px solid rgba(255,255,255,0.1);
    background: rgba(255,255,255,0.05);
    backdrop-filter: blur(5px);
    color: #d1d5db;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .filter-btn:hover,
  .filter-btn.active {
    background: var(--fuchsia);
    border-color: var(--fuchsia);
    color: #000;
    box-shadow: 0 0 20px rgba(217, 70, 239, 0.4);
    transform: translateY(-2px);
  }

  /* ----- Grid Layout ----- */
  .blog-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  @media (min-width: 768px) {
    .blog-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .blog-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* --- BLOG KARTY --- */
  /* --- BLOG KARTY - OPTIMALIZOVANÉ --- */
.blog-card {
  /* 1. MOBILE FIRST: Žiadny blur, tmavšie pozadie pre čitateľnosť */
  background: rgba(17, 24, 39, 0.95);
  backdrop-filter: none;
  -webkit-backdrop-filter: none;

  border: 1px solid rgba(34, 211, 238, 0.2);
  border-radius: 0.5rem;
  overflow: hidden;
  transition: all 0.5s;
  cursor: default;
  display: flex;
  flex-direction: column;

  /* 2. Hardvérová akcelerácia pre plynulý posun */
  transform: translateZ(0);
  will-change: transform;
}

/* 3. DESKTOP: Zapneme "Glassmorphism" efekt až na veľkých obrazovkách */
@media (min-width: 992px) {
  .blog-card {
    background: rgba(17, 24, 39, 0.5);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
  }
}

.blog-card:hover {
  border-color: rgba(34, 211, 238, 0.8);
  transform: translateY(-5px);
  /* Na mobile zjemníme tieň, na desktope necháme výrazný */
  box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.5);
}

@media (min-width: 992px) {
  .blog-card:hover {
    box-shadow: 0 0 20px rgba(34, 211, 238, 0.4);
  }
}

  .blog-card:hover {
    border-color: rgba(34, 211, 238, 0.8);
    transform: translateY(-5px);
    box-shadow: 0 0 20px rgba(34, 211, 238, 0.4);
  }

  /* Obrázok */
  .card-image-wrapper {
    height: 14rem;
    overflow: hidden;
  }

  .blog-img-optimized {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s;
  }

  .blog-card:hover .blog-img-optimized {
    transform: scale(1.05);
  }

  /* Obsah */
  .card-content {
    padding: 1.5rem;
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .card-title {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--cyan);
    margin-bottom: 0.5rem;
  }

  .card-excerpt {
    color: #d1d5db;
    margin-bottom: 1rem;
    line-height: 1.6;
  }

  /* TAGS */
  .card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }

  .tag {
    padding: 0.25rem 0.75rem;
    background-color: rgba(22, 78, 99, 0.5);
    color: #67e8f9;
    font-size: 0.875rem;
    border-radius: 9999px;
    border: 1px solid rgba(34, 211, 238, 0.3);
  }

  /* Footer / Čítať viac */
  .card-footer {
    margin-top: auto;
    display: flex;
    justify-content: flex-end;
  }

  .read-more-link {
    color: var(--fuchsia);
    text-decoration: none;
    font-weight: 600;
    cursor: pointer;
    transition: color 0.3s ease;
    display: inline-block;
  }

  .read-more-link:hover {
    text-decoration: underline;
    color: #e879f9;
  }

  /* ----- LOADER BUTTONS ----- */
  .load-more-wrapper {
    text-align: center;
    margin-top: 3rem;
  }

  .action-btn {
    padding: 1rem 3rem;
    font-size: 1rem;
    font-weight: 700;
    border-radius: 4px;
    cursor: pointer;
    border: none;
    transition: transform 0.2s ease, filter 0.2s ease;
  }

  .action-btn:hover {
    transform: scale(1.05);
    filter: brightness(1.1);
  }

  .neon-button-cyan {
    background: linear-gradient(90deg, #0891b2, var(--cyan));
    color: #000;
    box-shadow: 0 0 20px rgba(34,211,238,0.4);
  }

  .neon-button-fuchsia {
    background: linear-gradient(90deg, #a21caf, var(--fuchsia));
    color: #000;
    box-shadow: 0 0 20px rgba(217,70,239,0.4);
  }
  
  .empty-state {
    text-align: center;
    color: #9ca3af;
    font-style: italic;
    font-size: 1.25rem;
    padding: 4rem 0;
  }

  /* Animácia pre vstup */
  .fade-in-section {
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.6s ease-out, transform 0.6s ease-out;
  }
  .fade-in-section.is-visible {
    opacity: 1;
    transform: translateY(0);
  }
</style>

<script define:vars={{ blogPostsData }}>
// IIFE funkcia na izoláciu rozsahu premenných (aby sa nebili s Projects sekciou)
(function() {
    const INITIAL_COUNT = 3;
    const LOAD_STEP = 3;

    let currentTag = "Všetky";
    let visibleCount = INITIAL_COUNT;

    // DÔLEŽITÉ: Selektory sú obmedzené len na sekciu BLOG (#blog-filters)
    const filterBtns = document.querySelectorAll("#blog-filters .filter-btn");
    const blogCards = document.querySelectorAll(".blog-card");
    const loadMoreBtn = document.getElementById("blog-load-more");
    const showLessBtn = document.getElementById("blog-show-less");
    const emptyState = document.getElementById("blog-empty-state");
    const blogSection = document.getElementById("blog");

    function renderList() {
        let matched = 0;

        blogCards.forEach(card => {
            const rawTags = card.dataset.tags || "";
            const tags = rawTags.split(",").map(t => t.trim());
            
            const isAll = currentTag === "Všetky";
            const match = isAll || tags.includes(currentTag);

            if (match) {
                matched++;
                if (matched <= visibleCount) {
                    // Zobrazíme priamo kartu (lebo sme odstránili vonkajší <a> wrapper)
                    card.style.display = "flex"; 
                } else {
                    card.style.display = "none";
                }
            } else {
                card.style.display = "none";
            }
        });

        // Empty state
        if(emptyState) {
            emptyState.style.display = matched === 0 ? "block" : "none";
        }

        // Tlačidlá
        if(loadMoreBtn) {
            loadMoreBtn.style.display = matched > visibleCount ? "inline-block" : "none";
        }
        if(showLessBtn) {
            showLessBtn.style.display = visibleCount > INITIAL_COUNT ? "inline-block" : "none";
        }
    }

    // Event Listeners pre Filtre
    filterBtns.forEach(btn => {
        btn.addEventListener("click", (e) => {
            // Reset active class (iba pre blog tlačidlá)
            filterBtns.forEach(b => b.classList.remove("active"));
            e.currentTarget.classList.add("active");

            currentTag = e.currentTarget.dataset.tag;
            visibleCount = INITIAL_COUNT; 

            renderList();
        });
    });

    // Load More
    if(loadMoreBtn) {
        loadMoreBtn.addEventListener("click", () => {
            visibleCount += LOAD_STEP;
            renderList();
        });
    }

    // Show Less
    if(showLessBtn) {
        showLessBtn.addEventListener("click", () => {
            visibleCount = INITIAL_COUNT;
            renderList();
            if(blogSection) {
                blogSection.scrollIntoView({ behavior: "smooth" });
            }
        });
    }

    // Inicializácia pri načítaní stránky
    filterBtns.forEach(btn => {
        if (btn.dataset.tag === "Všetky") {
            btn.classList.add("active");
        } else {
            btn.classList.remove("active");
        }
    });
    
    // Observer pre fade-in animáciu (ak ju používaš globálne, toto zabezpečí aj blog)
    const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
            if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
            }
        });
    }, { threshold: 0.1 });
    
    document.querySelectorAll('.fade-in-section').forEach(el => observer.observe(el));

    renderList();

})(); // Koniec IIFE
</script>