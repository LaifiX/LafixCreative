---
// src/components/MobileNavBar.astro
// NOVÁ ŠTRUKTÚRA SO 6 IKONAMI
const navItems = [
    { name: 'Home', href: '#hero', section: 'hero', icon: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>` },
    { name: 'O Mne', href: '#about', section: 'about', icon: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 00-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>` },
    { name: 'Zručnosti', href: '#skills', section: 'skills', icon: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" 
  fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" 
  stroke-linejoin="round">
  <polyline points="16 18 22 12 16 6"></polyline>
  <polyline points="8 6 2 12 8 18"></polyline>
</svg>`},
    { name: 'Projekty', href: '#projects', section: 'projects', icon: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>` },
    { name: 'Blog', href: '#blog', section: 'blog', icon: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" 
    fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" 
    stroke-linejoin="round">
    <path d="M12 20h9"/>
    <path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4 12.5-12.5z"/>
  </svg>` },
   { name: 'Kontakt', href: '#contact', section: 'contact', icon: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><path d="M22 6l-10 7L2 6"/></svg>` },
];
---

<nav id="mobile-tab-bar" class="mobile-nav-bar">
    {navItems.map(item => (
        <a href={item.href} class="nav-item" data-section={item.section}>
            <div class="icon-svg" set:html={item.icon}></div>
            <span class="label">{item.name}</span>
        </a>
    ))}
</nav>

<style>
    /* --- BAR VZHĽAD A POZÍCIE --- */
    .mobile-nav-bar {
        display: none; 
        position: fixed;
        bottom: 0;
        left: 0;
        width: 100%;
        z-index: 5000;
        
        /* Silnejší Glassmorphism */
        background-color: rgba(0, 0, 0, 0.9);
        backdrop-filter: blur(16px);
        border-top: 1px solid rgba(217, 70, 239, 0.2); /* Fuchsia čiara */
        box-shadow: 0 -5px 20px rgba(0, 0, 0, 0.5); /* Tieň pod barom */
        
        /* Flexbox */
        display: flex;
        justify-content: space-around;
        padding: 0.5rem 0;
    }

    /* Zobrazí sa na mobiloch a tabletoch */
    @media (max-width: 1024px) {
        .mobile-nav-bar {
            display: flex;
        }
    }

    /* Skryje sa na desktope, kde už funguje klasické menu */
    @media (min-width: 928px) {
        .mobile-nav-bar {
            display: none !important;
        }
    }

    /* --- IKONY A TEXT --- */
    .nav-item {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-decoration: none;
        color: var(--gray);
        font-size: 0.75rem; /* Väčší text */
        font-weight: 500;
        transition: all 0.3s ease;
        flex: 1;
        padding: 0.3rem 0;
    }

    .icon-svg {
        width: 1.6rem;
        height: 1.6rem;
        color: var(--cyan); /* Základná farba ikon je Cyan */
        stroke-width: 2; /* Hrúbka SVG čiary */
        transition: all 0.3s ease;
    }

    .label {
        margin-top: 0.2rem;
        line-height: 1.2;
        transition: color 0.3s ease;
    }

    /* --- ACTIVE STATE (NEON GLOW) --- */
    .nav-item.active {
        color: white;
        transform: translateY(-4px); /* Jemný skok pri aktivácii */
    }

    .nav-item.active .icon-svg {
        color: white; 
        transform: scale(1.05);
        
        /* KĽÚČOVÁ NEON ŽIARA */
        filter: drop-shadow(0 0 10px var(--cyan)) drop-shadow(0 0 4px white);
    }
</style>

<script>
    // Logika Scroll Spy pre navigačnú lištu dole
    const mobileNavBar = document.getElementById('mobile-tab-bar');
    if (mobileNavBar) {
        const mobileLinks = mobileNavBar.querySelectorAll('.nav-item');
        const offset = 150; // Offset pre hlavičku

        function mobileScrollSpy() {
            const sections = document.querySelectorAll('section[id]');
            let currentSection = '';

            sections.forEach(section => {
                const sectionTop = section.offsetTop;
                if (window.scrollY >= (sectionTop - offset)) {
                    currentSection = section.getAttribute('id') || '';
                }
            });

            // Ak sme úplne na spodku, vynútime poslednú sekciu (#contact)
            if ((window.innerHeight + window.scrollY) >= document.body.offsetHeight - 50) {
                currentSection = 'contact';
            }

            // Nastav active class
            mobileLinks.forEach(link => {
                const target = (link as HTMLElement).dataset.section;
                link.classList.remove('active');
                if (target === currentSection) {
                    link.classList.add('active');
                }
            });
        }

        window.addEventListener('scroll', mobileScrollSpy);
        mobileScrollSpy(); // Spustiť hneď pri načítaní
    }
</script>



