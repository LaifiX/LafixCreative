---
// src/components/Skills.astro

const skillCategories = [
  {
    id: "tech",
    title: "Technology Stack",
    color: "cyan",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M17.25 6.75L22.5 12l-5.25 5.25m-10.5 0L1.5 12l5.25-5.25m7.5-3l-4.5 16.5" /></svg>`,
    skills: [
      { name: "HTML, CSS", level: 90 },
      { name: "JavaScript / TypeScript", level: 70 },
      { name: "React / Astro", level: 70 },
      { name: "UI/UX (Figma, Photoshop)", level: 80 },
      { name: "Python", level: 70 },
      { name: "AI applications", level: 90 },
      { name: "Vibe coding s porozumením", level: 95},
    ]
  },
  {
    id: "biz",
    title: "Business Intelligence",
    color: "fuchsia",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 013 19.875v-6.75zM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V8.625zM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V4.125z" /></svg>`,
    skills: [
      { name: "Obchodná komunikácia", level: 95 },
      { name: "Akvizícia zákazníkov", level: 90 },
      { name: "Obchodná prezentácia", level: 90 },
      { name: "Vyjednávanie", level: 85 },
      { name: "Analýza trhu", level: 80 },
      { name: "Branding & Marketing", level: 75 },
    ]
  }
];
---

<section id="skills" class="skills-section">
  <div class="container fade-in-section">
    
    <div class="header-wrapper">
        <h2 class="section-title">Arzenál Zručností</h2>
        <p class="section-subtitle">Kde sa stretáva <span class="text-cyan">Logika</span> s <span class="text-fuchsia">Persuáziou</span>.</p>
    </div>

    <div class="grid-wrapper">
        {skillCategories.map((category) => (
            <div class={`skill-card card-${category.color}`}>
                <div class="card-header">
                    <div class="icon-box" set:html={category.icon}></div>
                    <h3 class="card-title">{category.title}</h3>
                </div>
                <div class="skills-list">
                    {category.skills.map((skill, index) => (
                        <div class="skill-item">
                            <div class="skill-info">
                                <span class="skill-name">{skill.name}</span>
                                <span class="skill-pct">{skill.level}%</span>
                            </div>
                            <div class="progress-track">
                                <div 
                                    class="progress-fill" 
                                    data-width={skill.level}
                                    style={`transition-delay: ${index * 150}ms`}
                                >
                                    <div class="glare"></div>
                                </div>
                            </div>
                        </div>
                    ))}
                </div>
                <div class="corner top-left"></div>
                <div class="corner bottom-right"></div>
            </div>
        ))}
    </div>

  </div>
</section>

<style>
  :root { --cyan: #22d3ee; --fuchsia: #d946ef; }
  .skills-section { padding: 6rem 1.5rem; position: relative; }
  .container { max-width: 1200px; margin: 0 auto; }
  
  .header-wrapper { text-align: center; margin-bottom: 5rem; }
  .section-title { font-size: 2.5rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.1em; color: #fff; margin-bottom: 1rem; text-shadow: 0 0 20px rgba(255,255,255,0.1); }
  .section-subtitle { color: #9ca3af; font-size: 1.2rem; }
  .text-cyan { color: var(--cyan); text-shadow: 0 0 10px var(--cyan); }
  .text-fuchsia { color: var(--fuchsia); text-shadow: 0 0 10px var(--fuchsia); }

  .grid-wrapper { display: grid; grid-template-columns: 1fr; gap: 3rem; }
  @media (min-width: 992px) { .grid-wrapper { grid-template-columns: repeat(2, 1fr); gap: 5rem; } }

  /* --- KARTA: MOBILE FIRST (Optimalizované) --- */
  .skill-card { 
      /* Bez bluru na mobile */
      background: rgba(17, 24, 39, 0.95); 
      backdrop-filter: none;
      -webkit-backdrop-filter: none;

      border: 1px solid rgba(255,255,255,0.05); 
      padding: 2.5rem; 
      border-radius: 4px; 
      position: relative; 
      overflow: hidden; 
      
      /* GPU akcelerácia */
      transform: translateZ(0);
      will-change: transform;
      
      transition: transform 0.3s, box-shadow 0.3s; 
  }

  .skill-card:hover { transform: translateY(-5px); }
  /* Jemnejší tieň na mobile */
  .card-cyan:hover { border-color: rgba(34, 211, 238, 0.3); }
  .card-fuchsia:hover { border-color: rgba(217, 70, 239, 0.3); }

  /* --- DESKTOP EFEKTY PRE KARTU --- */
  @media (min-width: 992px) {
      .skill-card {
          background: rgba(17, 24, 39, 0.4); 
          backdrop-filter: blur(12px);
          -webkit-backdrop-filter: blur(12px);
      }
      .card-cyan:hover { box-shadow: 0 0 30px rgba(34, 211, 238, 0.1); }
      .card-fuchsia:hover { box-shadow: 0 0 30px rgba(217, 70, 239, 0.1); }
  }

  .card-header { display: flex; align-items: center; gap: 1rem; margin-bottom: 2.5rem; border-bottom: 1px solid rgba(255,255,255,0.1); padding-bottom: 1.5rem; }
  .icon-box { width: 3rem; height: 3rem; }
  .card-cyan .icon-box { color: var(--cyan); }
  .card-fuchsia .icon-box { color: var(--fuchsia); }
  .card-title { font-size: 1.5rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: #fff; }

  .skills-list { display: flex; flex-direction: column; gap: 1.5rem; }
  .skill-item { width: 100%; }
  .skill-info { display: flex; justify-content: space-between; margin-bottom: 0.5rem; font-size: 1rem; font-weight: 500; }
  .skill-name { color: #d1d5db; }
  .skill-pct { font-family: monospace; opacity: 0.7; color: #fff; }

  .progress-track { width: 100%; height: 8px; background: rgba(255,255,255,0.1); border-radius: 99px; overflow: hidden; position: relative; }
  
  /* --- PROGRESS BAR: MOBILE FIRST --- */
  .progress-fill { 
      height: 100%; 
      width: 0; 
      position: relative; 
      border-radius: 99px; 
      transition: width 1.5s cubic-bezier(0.22, 1, 0.36, 1); 
      /* Na mobile vypneme ťažké tiene */
      box-shadow: none;
  }
  
  .card-cyan .progress-fill { background: linear-gradient(90deg, #0891b2, var(--cyan)); }
  .card-fuchsia .progress-fill { background: linear-gradient(90deg, #a21caf, var(--fuchsia)); }
  
  /* Odlesk (Glare) v základe skryjeme, aby nežral batériu na mobile */
  .glare { display: none; }

  /* --- DESKTOP EFEKTY PRE PROGRESS BAR --- */
  @media (min-width: 992px) {
      .card-cyan .progress-fill { box-shadow: 0 0 10px var(--cyan); }
      .card-fuchsia .progress-fill { box-shadow: 0 0 10px var(--fuchsia); }
      
      /* Zapneme animáciu odlesku len na desktope */
      .glare { 
          display: block;
          position: absolute; top: 0; left: 0; width: 100%; height: 100%; 
          background: linear-gradient(90deg, transparent, rgba(255,255,255,0.4), transparent); 
          transform: translateX(-100%); 
          animation: shimmer 2s infinite; 
      }
  }

  @keyframes shimmer { 100% { transform: translateX(100%); } }

  .corner { position: absolute; width: 20px; height: 20px; border: 2px solid transparent; transition: all 0.3s; }
  .card-cyan .corner { border-color: var(--cyan); }
  .card-fuchsia .corner { border-color: var(--fuchsia); }
  .top-left { top: 0; left: 0; border-right: none; border-bottom: none; }
  .bottom-right { bottom: 0; right: 0; border-left: none; border-top: none; }

  .fade-in-section { opacity: 0; transform: translateY(30px); transition: opacity 0.8s, transform 0.8s; }
  .fade-in-section.is-visible { opacity: 1; transform: translateY(0); }
</style>

<script>
  // Čistý Vanilla JS bez TypeScript typov
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('is-visible');
        
        // Nájdeme všetky bary v tejto sekcii
        const bars = entry.target.querySelectorAll('.progress-fill');
        
        bars.forEach((bar) => {
            // Bezpečne prečítame data-width
            // Používame 'getAttribute' lebo je to robustnejšie než dataset v niektorých prípadoch
            const targetWidth = bar.getAttribute('data-width');
            
            setTimeout(() => {
                if (targetWidth) {
                    bar.style.width = targetWidth + '%';
                }
            }, 100);
        });
        
        observer.unobserve(entry.target);
      }
    });
  }, { threshold: 0.15 });

  const elements = document.querySelectorAll('.fade-in-section');
  elements.forEach(el => observer.observe(el));
</script>