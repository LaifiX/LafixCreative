---
// src/components/Hero.astro
import AnimatedBackground from './AnimatedBackground.astro';
import { Image } from 'astro:assets';
import heroImage from '../assets/images/neoavatar.webp';
---

<section id="hero" class="hero-section">
  <AnimatedBackground />

  <div class="container">
    <div class="grid-layout">
      
      <div class="content-col">
        <h1 class="title">
          <span class="text-white">AHOJ, SOM </span>
          <span class="text-highlight neon-text">PETER</span>
        </h1>

        <p class="typewriter-wrapper">
          <span class="bracket">[</span>
          <span id="typewriter-text" class="typewriter-text"></span>
          <span class="cursor">|</span>
          <span class="bracket">]</span>
        </p>

 <p class="description">
  Prepájam dva svety - <span class="highlight-fuchsia">obchod a technológie.</span> 
  <b>8&nbsp;rokov prinášam výsledky v obchode a vo vyjednávaní.</b>
</p>

<p class="description">
  Tvorím webové aplikácie a AI riešenia, ktoré nepôsobia len moderne — 
  <span class="highlight-fuchsia">pomáhajú predávať, šetria čas a zvyšujú výkon.</span> 
  Rozumiem kódu aj zákazníkovi, preto viem doručiť riešenia s&nbsp;reálnym dopadom.
</p>

<p class="description">
  Ak hľadáte človeka, ktorý vie myslieť obchodne, konať technicky a doručovať rýchlo,  
  <span class="highlight-cyan"><strong>rád sa s vami porozprávam.</strong></span>
</p>


        <a href="#projects" class="cta-button">
          Moje projekty
        </a>
      </div>

      <div class="image-col">
        <div class="image-wrapper">
            <Image 
                src={heroImage} 
                alt="Peter - Developer a Obchodník" 
                class="hero-image"
                loading="eager" 
                fetchpriority="high"
                widths={[350, 600, 1000]} 
                sizes="(max-width: 768px) 350px, (max-width: 1200px) 600px, 1000px"
                format="webp"
                quality={80}
            />
            <div class="glow-effect"></div>
        </div>
      </div>
     </div>
  </div>
</section>

<style>
  /* PREMENNÉ */
  :root {
    --fuchsia: #d946ef;
    --cyan: #22d3ee;
    --text-gray: #d1d5db;
  }

   .highlight-fuchsia { color: var(--fuchsia); font-weight: 700; }
  .highlight-cyan { color: var(--cyan); font-weight: 700; }

  /* ZÁKLADNÝ LAYOUT */
  .hero-section {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    padding-top: 280px;
    padding-bottom: 4rem;
  }

  .container {
    width: 100%;
    max-width: 1200px;
    padding: 0 1.5rem;
    position: relative;
    z-index: 10;
  }

  .grid-layout {
    display: flex;
    flex-direction: column-reverse; /* Mobil: Fotka dole/skrytá, Text hore */
    align-items: center;
    gap: 2rem;
    text-align: center;
  }

  /* --- TYPOGRAPHY & TEXT --- */
  .content-col {
    position: relative;
    z-index: 20;
  }

  .title {
    font-size: clamp(2.5rem, 5vw, 4.5rem);
    font-weight: 800;
    text-transform: uppercase;
    line-height: 1.1;
    margin-bottom: 1rem;
    min-height: 1.1em;
  }

  .text-white { color: #fff; }
  .text-highlight { color: var(--fuchsia); display: inline-block; }
  .neon-text { text-shadow: 0 0 20px rgba(217, 70, 239, 0.6); }

  .typewriter-wrapper {
    font-size: clamp(1.25rem, 3vw, 2rem);
    font-weight: 400;
    color: var(--cyan);
    margin-bottom: 2rem;
    font-family: monospace;
    height: 3rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .bracket { opacity: 0.5; color: #fff; }
  .cursor { animation: blink 1s step-end infinite; font-weight: bold; color: var(--fuchsia); margin-left: 5px; }
  @keyframes blink { 50% { opacity: 0; } }

  .description {
    font-size: 1.125rem;
    color: var(--text-gray);
    line-height: 1.6;
    margin-bottom: 3rem;
    max-width: 540px;
    margin-left: auto;
    margin-right: auto;
   
  }

  /* --- TLAČIDLO (CTA) --- */
  .cta-button {
    display: inline-block;
    padding: 1rem 3rem;
    border-radius: 4px;
    background: linear-gradient(90deg, #a21caf, var(--fuchsia));
    border: none;
    color: #000;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-weight: 800;
    text-decoration: none;
    box-shadow: 0 0 25px rgba(217, 70, 239, 0.4);
    margin-top: 1rem;
    position: relative;
    z-index: 30;
    cursor: pointer;
    transition: transform 0.2s, filter 0.2s, box-shadow 0.2s;
  }

  .cta-button:hover {
    transform: scale(1.05);
    filter: brightness(1.1);
    box-shadow: 0 0 40px rgba(217, 70, 239, 0.6);
  }

  /* --- IMAGE STYLES (Základ) --- */
  .image-wrapper {
    position: relative;
    width: 100%;
    max-width: 650px;
    aspect-ratio: 4 / 5;
    animation: float 6s ease-in-out infinite;
    z-index: 9001;
    pointer-events: none;
  }

  .hero-image {
    width: 120%;
    height: auto;
    position: relative;
    z-index: 10000;
    mask-image: linear-gradient(to bottom, black 80%, transparent 100%);
    -webkit-mask-image: linear-gradient(to bottom, black 80%, transparent 100%);
    filter: drop-shadow(0 0 20px rgba(34, 211, 238, 0.2));
    margin-top: -1rem;
  }

  .glow-effect {
    position: absolute;
    top: 20%;
    left: 50%;
    transform: translateX(-50%);
    width: 80%;
    height: 60%;
    background: radial-gradient(circle, rgba(34, 211, 238, 0.4) 0%, transparent 70%);
    z-index: 1;
    filter: blur(40px);
    opacity: 0.6;
  }

  @keyframes float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-15px); }
  }

  /* --- DESKTOP (PC) --- */
  @media (min-width: 992px) {
    .grid-layout {
      flex-direction: row;
      text-align: left;
      justify-content: space-between;
      margin-top: -5rem;
    }
  
    .content-col {
      flex: 0 0 45%; /* Opravená syntax - pridal som bodkočiarku */
      padding-right: 2rem;
      margin-top: -5rem;
      
    }
    
    .image-col {
      flex: 0 0 60%; /* Opravená syntax */
      display: flex;
      justify-content: flex-end;
      padding-top: -5rem;
    }

    .typewriter-wrapper { justify-content: flex-start; }
    .description { margin-left: 0; margin-right: 0; margin-bottom: 25px; }
  }


@media (max-width:992px){
    .hero-section {padding-top: 200px;}

}

  /* --- MOBIL (Phone) --- */
  @media (max-width: 768px) {
    .grid-layout {
      grid-template-columns: 1fr;
      text-align: center;
      padding-top: 4rem;
      display: flex;
      flex-direction: column;
    }

    /* Poradie: 1. Obrázok, 2. Text (Podľa tvojho želania v kóde si mal order 2/1) */
    /* Ak chceš Text prvý, vymeň čísla */
    .content-col { order: 2; margin-top:-1rem; }
    .image-col { 
        order: 1; 
        display: flex;
        justify-content: center;
        width: 125%;
        z-index: 9001;
        margin-bottom: -9rem;
       
    }
    
    .image-wrapper {
        max-width: 90%;
        margin-top: -9rem;
        aspect-ratio: 4 / 5;
    }
  }




</style>

<script>
  const roles = ["OBCHODNÝ ZÁSTUPCA","PROGRAMÁTOR", "INOVÁTOR", "KREATÍVEC"];
  const textElement = document.getElementById('typewriter-text');
  
  let loopNum = 0;
  let isDeleting = false;
  let txt = '';
  let delta = 150;
  const period = 2000;

  function tick() {
    if (!textElement) return;
    const i = loopNum % roles.length;
    const fullText = roles[i];

    if (isDeleting) {
      txt = fullText.substring(0, txt.length - 1);
      delta = 80;
    } else {
      txt = fullText.substring(0, txt.length + 1);
      delta = 150;
    }

    textElement.innerHTML = txt;

    if (!isDeleting && txt === fullText) {
      delta = period;
      isDeleting = true;
    } else if (isDeleting && txt === '') {
      isDeleting = false;
      loopNum++;
      delta = 500;
    }

    setTimeout(tick, delta);
  }

  document.addEventListener('DOMContentLoaded', () => {
    tick();
  });
</script>