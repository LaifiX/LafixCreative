---

const navLinks = [
  { name: 'O Mne', href: '#about' },
  { name: 'Zručnosti', href: '#skills' },
  { name: 'Projekty', href: '#projects' },
  { name: 'Blog', href: '#blog' },
  { name: 'Na stiahnutie', href: '#download' },
];
---

<header id="main-header" class="header">
  <nav class="nav-container">
   <a href="#" class="logo">
      <span class="logo-part">
        <span class="text-white">L</span><span class="text-cyan">AI</span><span class="text-white">FIX</span>
      </span>
      
      <span class="logo-part">
        <span class="text-cyan">CREA</span><span class="text-white">TIVE AGENCY</span>
      </span>
      
    </a>

    <div class="desktop-menu">
      {navLinks.map((link) => (
        <a href={link.href} class="nav-link">
          {link.name}
        </a>
      ))}
      <a href="#contact" class="contact-btn">
        Kontakt
      </a>
    </div>

    <button id="menu-toggle" class="mobile-toggle" aria-label="Menu">
      <svg class="icon-hamburger" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
      <svg class="icon-close" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
         <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </nav>
  
  <div class="scroll-progress-container">
    <div class="scroll-progress-bar" id="scroll-bar"></div>
  </div>
</header>

<div id="mobile-menu" class="mobile-menu-overlay">
  <div class="mobile-menu-content">
    <div class="mobile-links">
      {navLinks.map((link) => (
        <a href={link.href} class="mobile-link">
          {link.name}
        </a>
      ))}
      <a href="#contact" class="mobile-link highlight">
        Kontakt
      </a>
    </div>
  </div>
</div>

<style>
  /* 1. DEFINÍCIA PREMENNÝCH */
  :root {
    --cyan: #22d3ee;
    --cyan-hover: #67e8f9;
    --fuchsia: #d946ef;
    --gray: #d1d5db;
    --bg-dark: rgba(0, 0, 0, 0.5);
  }

  /* 2. HEADER LAYOUT */
  .header {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 10001; /* Najvyššia priorita */
    padding: 1rem 0;
    /* Opravená transition - odstránené 'all' pre lepší výkon */
    transition: background-color 0.3s ease, padding 0.3s ease, backdrop-filter 0.3s ease;
    background-color: transparent; 
  }

  .header.scrolled {
    background-color: rgba(0, 0, 0, 0.8);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    padding: 0.5rem 0;
    border-bottom: 1px solid rgba(34, 211, 238, 0.1);
  }

  .nav-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    position: relative;
  }

  /* LOGO */
  /* LOGO KONTAJNER */
  /* LOGO HLAVNÝ KONTAJNER */
  .logo {
    font-family: 'Impact', 'Oswald', 'Space Grotesk', sans-serif; /* Hrubý font */
    font-size: 1.8rem;
    font-weight: 900;
    letter-spacing: 0.02em;
    text-decoration: none;
    display: flex;
    align-items: center;
    gap: 0.4rem; /* Medzera medzi LAIFIX a CREATOR */
    z-index: 10001;
    line-height: 1;
  }

  /* POMOCNÉ TRIEDY PRE FARBY */
  
  /* Biela */
  .text-white {
    color: #eae9e9;
    /* Jemný tieň pre kontrast */
   
  }

  /* Červená (Tech Red - ladená k obrázku) */
  .text-red {
    color: #ff4d4d; 
    /* Červená žiara */
   
  }

  /* Modrá (Tvoja Cyan) */
  .text-cyan {
    color: var(--cyan);
    /* Modrá žiara */
    
  }

  /* Hover efekt pre celé logo */
  .logo:hover .text-red {
    filter: drop-shadow(0 0 12px rgba(255, 77, 77, 0.9));
  }
  .logo:hover .text-cyan {
    filter: drop-shadow(0 0 12px rgba(34, 211, 238, 0.9));
  }
  
  .logo:hover .text-white {
    filter: drop-shadow(0 0 12px rgba(226, 226, 226, 0.9));
  }

  /* TLAČIDLO MENU (JEDNO TLAČIDLO) */
  .mobile-toggle {
    background: none;
    border: none;
    color: var(--gray);
    cursor: pointer;
    width: 48px;
    height: 48px;
    display: flex; /* Flex zabezpečí, že je viditeľné */
    align-items: center;
    justify-content: center;
    position: relative; /* Pre absolútne ikonky vnútri */
    z-index: 10001; /* Musí byť nad overlayom */
  }
  
  .mobile-toggle:hover { color: var(--fuchsia); }

  /* Ikonky vnútri tlačidla */
  .icon-hamburger, .icon-close {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 32px;
    height: 32px;
    /* Toto zabezpečí dokonalé centrovanie */
    transform-origin: center;
    transition: all 0.4s cubic-bezier(0.68, -0.55, 0.265, 1.55);
  }

  /* STAV 1: ZATVORENÉ (Vidíme Hamburger) */
  .icon-hamburger {
    opacity: 1;
    transform: translate(-50%, -50%) rotate(0deg) scale(1);
    color: var(--cyan); /* Alebo --gray podľa preferencie */
  }
  .icon-close {
    opacity: 0;
    transform: translate(-50%, -50%) rotate(-90deg) scale(0.5);
  }

  /* STAV 2: OTVORENÉ (Vidíme Krížik) */
  .mobile-toggle.is-active .icon-hamburger {
    opacity: 0;
    transform: translate(-50%, -50%) rotate(90deg) scale(0.5);
  }
  .mobile-toggle.is-active .icon-close {
    opacity: 1;
    transform: translate(-50%, -50%) rotate(0deg) scale(1);
    color: var(--fuchsia);
  }

  /* DESKTOP MENU */
  .desktop-menu {
    display: none; /* Defaultne skryté na mobile */
    align-items: center;
    gap: 2rem;
  }
