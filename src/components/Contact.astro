---
// src/components/Contact.astro
---

<section id="contact" class="contact-section">
  <div class="container fade-in-section">
    
    <h2 class="section-title neon-text-cyan">Kontaktujte Ma</h2>

    <div class="form-wrapper">
      
      <form 
        id="contact-form" 
        class="contact-form" 
        name="contact" 
        method="POST" 
        data-netlify="true"
      >
        <input type="hidden" name="form-name" value="contact" />
        
        <div class="input-group">
          <input 
            type="text" 
            name="name" 
            id="name"
            class="input-field" 
            placeholder=" " 
            required 
          />
          <label for="name" class="input-label">Vaše Meno</label>
          <div class="input-highlight"></div>
        </div>

        <div class="input-group">
          <input 
            type="email" 
            name="email" 
            id="email" 
            class="input-field" 
            placeholder=" " 
            required 
          />
          <label for="email" class="input-label">Váš Email</label>
          <div class="input-highlight"></div>
        </div>

        <div class="input-group">
          <textarea 
            name="message" 
            id="message" 
            class="input-field textarea" 
            placeholder=" " 
            rows="4" 
            required
          ></textarea>
          <label for="message" class="input-label">Vaša Správa</label>
          <div class="input-highlight"></div>
        </div>

        <div class="button-wrapper">
          <button type="submit" class="submit-btn">
            <span class="btn-text">Odoslať Správu</span>
          </button>
        </div>

      </form>

      <p id="form-status" class="status-message"></p>
    </div>

  </div>
</section>

<style>
  .contact-section {
    padding: 6rem 1.5rem;
    position: relative;
  }

  .container { max-width: 1200px; margin: 0 auto; }
  .form-wrapper { max-width: 600px; margin: 0 auto; }

  .section-title {
    text-align: center;
    font-size: 2.5rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--cyan, #22d3ee);
    margin-bottom: 4rem;
  }
  .neon-text-cyan { text-shadow: 0 0 10px rgba(34, 211, 238, 0.5); }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  /* --- INPUTY --- */
  .input-group { position: relative; width: 100%; }

  .input-field {
    width: 100%;
    background: transparent;
    border: none;
    border-bottom: 1px solid rgba(255, 255, 255, 0.2);
    padding: 1rem 0;
    color: white;
    font-size: 1.1rem;
    font-family: inherit;
    outline: none;
    transition: border-color 0.3s;
  }

  .textarea { resize: vertical; min-height: 100px; }

  .input-label {
    position: absolute;
    top: 1rem;
    left: 0;
    color: #9ca3af;
    font-size: 1.1rem;
    pointer-events: none;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .input-field:focus ~ .input-label,
  .input-field:not(:placeholder-shown) ~ .input-label {
    top: -1.2rem;
    font-size: 0.85rem;
    color: var(--cyan);
    font-weight: 600;
    letter-spacing: 0.05em;
  }

  .input-highlight {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 0;
    height: 2px;
    background: linear-gradient(90deg, var(--cyan), var(--fuchsia));
    transition: width 0.4s ease;
  }

  .input-field:focus ~ .input-highlight { width: 100%; }
  .input-field:valid:not(:placeholder-shown) ~ .input-highlight { background: #10b981; width: 100%; }

  /* --- TLAČIDLO (OPRAVENÉ) --- */
  .button-wrapper { 
    display: flex;
    justify-content: center; 
    align-items: center;
    margin-top: 2rem; 
    width: 100%;
  }

  .submit-btn {
    position: relative;
    padding: 1rem 0;
    background: transparent;
    border: 1px solid var(--fuchsia);
    color: var(--fuchsia);
    font-size: 1.1rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    cursor: pointer;
    overflow: hidden;
    transition: all 0.3s;
    border-radius: 4px;
    width: 100%;
    max-width: 300px;
    
    display: flex;
    justify-content: center;
    align-items: center;
    z-index: 1;
  }

  /* Pozadie (gradient) skryté vľavo */
  .submit-btn::before {
    content: '';
    position: absolute;
    top: 0; left: -100%;
    width: 100%; height: 100%;
    background: linear-gradient(90deg, var(--fuchsia), #a21caf);
    transition: left 0.4s ease;
    z-index: -1;
  }

  /* !!! TU BOLA CHYBA !!!
     Vymazal som globálny hover efekt.
     Teraz je hover efekt len vnútri tejto podmienky pre myš:
  */
  @media (hover: hover) {
    .submit-btn:hover {
        color: white;
        box-shadow: 0 0 30px rgba(217, 70, 239, 0.4);
        border-color: transparent;
    }

    .submit-btn:hover::before {
        left: 0; /* Vyplní sa len keď je tam fyzická myš */
    }
  }

  /* --- STAV ODOSLANÉ (Active) --- */
  /* Toto zabezpečí vyplnenie farbou, keď to prikáže JavaScript */
  .submit-btn.sent-active {
    color: white;
    border-color: transparent;
    box-shadow: 0 0 30px rgba(217, 70, 239, 0.4);
    cursor: default;
  }

  .submit-btn.sent-active::before {
    left: 0; /* Vynútené vyplnenie */
  }

  /* --- DISABLED STAV --- */
  .submit-btn:disabled {
    opacity: 1;
    pointer-events: none;
  }

  /* --- STATUS SPRÁVA --- */
  .status-message {
    text-align: center;
    margin-top: 2rem;
    min-height: 1.5rem;
    font-weight: 600;
    opacity: 0;
    transition: opacity 0.3s;
  }
  .status-message.visible { opacity: 1; }
  .status-message.success { color: #22d3ee; }
  .status-message.error { color: #ef4444; }

  /* Fade In */
  .fade-in-section { opacity: 0; transform: translateY(20px); transition: opacity 0.6s, transform 0.6s; }
  .fade-in-section.is-visible { opacity: 1; transform: translateY(0); }
</style>



<script>
  const form = document.getElementById('contact-form');
  const statusMsg = document.getElementById('form-status');

  if (form) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();

      if (!statusMsg) return;

      const btn = form.querySelector('button');
      const btnText = btn.querySelector('.btn-text');
      const originalText = 'Odoslať Správu'; // Pôvodný text natvrdo, aby sa nemenil
      
      // 1. OKAMŽITÝ LOCK (Zabráni posúvaniu a dvojklikom)
      btn.disabled = true; 
      btn.style.opacity = '0.7';
      if (btnText) btnText.textContent = 'Odosielam...';
      
      const formData = new FormData(form);

      // 2. Odoslanie
      fetch("/", {
        method: "POST",
        headers: { "Content-Type": "application/x-www-form-urlencoded" },
        body: new URLSearchParams(formData).toString()
      })
      .then(() => {
        // --- ÚSPECH ---
        
        if (btnText) btnText.textContent = 'Odoslané';
        
        // Pridáme efekt (fialová výplň)
        btn.classList.add('sent-active');
        // Tlačidlo ostáva disabled (to sme nastavili už na začiatku)

        statusMsg.textContent = '✓ Správa bola úspešne odoslaná! Ďakujem.';
        statusMsg.className = 'status-message visible success';
        
        form.reset();
        
        // 3. RESET PO 4 SEKUNDÁCH
        setTimeout(() => {
            if (btnText) btnText.textContent = originalText;
            
            btn.classList.remove('sent-active');
            
            // Až teraz znova povolíme klikanie
            btn.disabled = false;
            btn.style.opacity = '1';
            
            statusMsg.classList.remove('visible');
            btn.blur(); 
        }, 4000);

      })
      .catch(error => {
        // --- CHYBA ---
        console.error('Error:', error);
        statusMsg.textContent = '⚠ Niečo sa pokazilo. Skúste to neskôr.';
        statusMsg.className = 'status-message visible error';
        
        // V prípade chyby musíme tlačidlo odomknúť hneď
        if (btnText) btnText.textContent = originalText;
        btn.style.opacity = '1';
        btn.disabled = false;
      });
    });
  }
</script>