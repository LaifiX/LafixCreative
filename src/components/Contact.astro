---
// src/components/Contact.astro
---

<section id="contact" class="contact-section">
  <div class="container fade-in-section">
    
    <h2 class="section-title neon-text-cyan">Kontaktujte Ma</h2>

    <div class="form-wrapper">
      
      <form 
        id="contact-form" 
        class="contact-form" 
        name="contact" 
        method="POST" 
        data-netlify="true"
      >
        <input type="hidden" name="form-name" value="contact" />
        
        <div class="input-group">
          <input 
            type="text" 
            name="name" 
            id="name"
            class="input-field" 
            placeholder=" " 
            required 
          />
          <label for="name" class="input-label">Vaše Meno</label>
          <div class="input-highlight"></div>
        </div>

        <div class="input-group">
          <input 
            type="email" 
            name="email" 
            id="email" 
            class="input-field" 
            placeholder=" " 
            required 
          />
          <label for="email" class="input-label">Váš Email</label>
          <div class="input-highlight"></div>
        </div>

        <div class="input-group">
          <textarea 
            name="message" 
            id="message" 
            class="input-field textarea" 
            placeholder=" " 
            rows="4" 
            required
          ></textarea>
          <label for="message" class="input-label">Vaša Správa</label>
          <div class="input-highlight"></div>
        </div>

        <div class="button-wrapper">
          <button type="submit" class="submit-btn">
            <span class="btn-text">Odoslať Správu</span>
          </button>
        </div>

      </form>

      <p id="form-status" class="status-message"></p>
    </div>

  </div>
</section>

<style>
  .contact-section {
    padding: 6rem 1.5rem;
    position: relative;
  }

  .container { max-width: 1200px; margin: 0 auto; }
  .form-wrapper { max-width: 600px; margin: 0 auto; } /* Užší formulár pre lepší focus */

  .section-title {
    text-align: center;
    font-size: 2.5rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--cyan, #22d3ee);
    margin-bottom: 4rem;
  }
  .neon-text-cyan { text-shadow: 0 0 10px rgba(34, 211, 238, 0.5); }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 2.5rem; /* Väčšie medzery pre vzdušnosť */
  }

  /* --- NOVÉ INPUTY (Underline Style) --- */
  .input-group {
    position: relative;
    width: 100%;
  }

  .input-field {
    width: 100%;
    background: transparent;
    border: none;
    border-bottom: 1px solid rgba(255, 255, 255, 0.2); /* Jemná čiara */
    padding: 1rem 0;
    color: white;
    font-size: 1.1rem;
    font-family: inherit;
    outline: none;
    transition: border-color 0.3s;
  }

  .textarea { resize: vertical; min-height: 100px; }

  /* Floating Label */
  .input-label {
    position: absolute;
    top: 1rem;
    left: 0;
    color: #9ca3af;
    font-size: 1.1rem;
    pointer-events: none; /* Aby sa dalo klikať cez text */
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  /* Animácia Labelu: Keď je focus alebo je vyplnené (placeholder-shown trik) */
  .input-field:focus ~ .input-label,
  .input-field:not(:placeholder-shown) ~ .input-label {
    top: -1.2rem;
    font-size: 0.85rem;
    color: var(--cyan);
    font-weight: 600;
    letter-spacing: 0.05em;
  }

  /* Highlight Line (Animovaná čiara zospodu) */
  .input-highlight {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 0;
    height: 2px;
    background: linear-gradient(90deg, var(--cyan), var(--fuchsia));
    transition: width 0.4s ease;
  }

  .input-field:focus ~ .input-highlight {
    width: 100%; /* Roztiahne sa na celú šírku */
  }

  /* Validácia (Zelená čiara pri platnom vstupe) */
  .input-field:valid:not(:placeholder-shown) ~ .input-highlight {
    background: #10b981; /* Emerald Green */
    width: 100%;
  }

  /* --- TLAČIDLO (Cyberpunk Style) --- */
 .button-wrapper { 
    display: flex;         /* Nahradí text-align: center */
    justify-content: center; 
    align-items: center;
    margin-top: 2rem; 
    width: 100%;
}

  .submit-btn {
    position: relative;
    padding: 1rem 3rem;
    background: transparent;
    border: 1px solid var(--fuchsia);
    color: var(--fuchsia);
    font-size: 1.1rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    cursor: pointer;
    overflow: hidden;
    transition: all 0.3s;
    border-radius: 4px;
    min-width: 250px;    /* Tlačidlo bude mať vždy aspoň túto šírku */
    text-align: center;  /* Text vnútri bude vždy v strede */
    display: flex;       /* Pre istotu vycentrujeme span vnútri */
    justify-content: center;
  }

  /* Hover efekt: Vyplnenie gradientom */
  .submit-btn::before {
    content: '';
    position: absolute;
    top: 0; left: -100%;
    width: 100%; height: 100%;
    background: linear-gradient(90deg, var(--fuchsia), #a21caf);
    transition: left 0.4s ease;
    z-index: -1;
  }

  .submit-btn:hover {
    color: white;
    box-shadow: 0 0 30px rgba(217, 70, 239, 0.4);
    border-color: transparent;
  }

  .submit-btn:hover::before {
    left: 0;
  }

  /* Status správa */
  .status-message {
    text-align: center;
    margin-top: 2rem;
    min-height: 1.5rem;
    font-weight: 600;
    opacity: 0;
    transition: opacity 0.3s;
  }
  .status-message.visible { opacity: 1; }
  .status-message.success { color: #22d3ee; }
  .status-message.error { color: #ef4444; }

  /* Fade In */
  .fade-in-section { opacity: 0; transform: translateY(20px); transition: opacity 0.6s, transform 0.6s; }
  .fade-in-section.is-visible { opacity: 1; transform: translateY(0); }
</style>

<script>
  const form = document.getElementById('contact-form');
  const statusMsg = document.getElementById('form-status');

  if (form) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();

      if (!statusMsg) return;

      // 1. UI Loading
      const btn = form.querySelector('button');
      const btnText = btn.querySelector('.btn-text');
      const originalText = btnText ? btnText.textContent : 'Odoslať';
      
      if (btnText) btnText.textContent = 'Odosielam...';
      btn.style.opacity = '0.7';
      
      // 2. Zber dát
      const formData = new FormData(form as HTMLFormElement);

      // 3. Odoslanie na Netlify (AJAX)
      // Posielame to na "/", ale musíme správne enkódovať dáta
      fetch("/", {
        method: "POST",
        headers: { "Content-Type": "application/x-www-form-urlencoded" },
        body: new URLSearchParams(formData as any).toString()
      })
      .then(() => {
        // ÚSPECH
        statusMsg.textContent = '✓ Správa bola úspešne odoslaná! Ďakujem.';
        statusMsg.className = 'status-message visible success';
        
        (form as HTMLFormElement).reset();
        
        if (btnText) btnText.textContent = originalText;
        btn.style.opacity = '1';

        setTimeout(() => { statusMsg.classList.remove('visible'); }, 5000);
      })
      .catch(error => {
        // CHYBA
        console.error('Error:', error);
        statusMsg.textContent = '⚠ Niečo sa pokazilo. Skúste to neskôr.';
        statusMsg.className = 'status-message visible error';
        
        if (btnText) btnText.textContent = originalText;
        btn.style.opacity = '1';
      });
    });
  }

  // Observer pre animáciu
  const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
          if (entry.isIntersecting) entry.target.classList.add('is-visible');
      });
  }, { threshold: 0.1 });
  document.querySelectorAll('.fade-in-section').forEach(el => observer.observe(el));
</script>