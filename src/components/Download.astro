---
// src/components/Download.astro
---

<section id="download" class="download-section">
  <div class="container fade-in-section">
    
    <h2 class="section-title neon-text-fuchsia">Na Stiahnutie</h2>

    <div class="download-banner">
        
        <div class="top-glow-line"></div>

        <button id="download-icon-btn" class="icon-wrapper no-magnet" aria-label="Stiahnuť">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="banner-icon">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3" />
            </svg>
        </button>

        <div class="text-content">
            <h3 class="banner-heading">E-booky a Materiály</h3>
            <p class="banner-desc">
                V tejto sekcii nájdete užitočné materiály na stiahnutie zdarma. 
                <br><span class="note">Žiaľ, momentálne žiadny e-book nie je k dispozícii.</span>
            </p>
        </div>

        <div class="action-wrapper">
            <button id="download-text-btn" class="glow-button no-magnet">
                Stiahnuť E-book
            </button>
        </div>

    </div>

  </div>
</section>

<style>
  .download-section {
    /* Vonkajšie odsadenie (ostáva menšie, aby to bolo kompaktné) */
    padding: 4rem 1.5rem; 
    position: relative;
    margin: 2rem 0;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .section-title {
    text-align: center;
    font-size: 2.2rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--fuchsia, #d946ef);
    margin-bottom: 3rem;
  }

  .neon-text-fuchsia {
    text-shadow: 0 0 10px rgba(217, 70, 239, 0.5), 0 0 20px rgba(217, 70, 239, 0.3);
  }

  /* --- BANNER (VNÚTORNÉ PADDINGY UPRAVENÉ) --- */
  .download-banner {
    background: linear-gradient(90deg, rgba(17, 24, 39, 0.8), rgba(0, 0, 0, 0.9));
    backdrop-filter: blur(10px);
    border: 1px solid rgba(217, 70, 239, 0.2);
    border-radius: 1rem;
    
    /* ZMENA: Väčší vnútorný padding pre mobil (aby text dýchal) */
    /* Predtým: 2rem 1.5rem -> Teraz: 3rem 2rem */
    padding: 3rem 2rem; 
    
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 2rem; /* Väčšia medzera medzi prvkami */
    position: relative;
    overflow: hidden;
    box-shadow: 0 0 40px rgba(0,0,0,0.5);
    max-width: 100%;
  }

  .top-glow-line {
    position: absolute;
    top: 0; left: 0; width: 100%; height: 1px;
    background: linear-gradient(90deg, transparent, var(--fuchsia), transparent);
    opacity: 0.8;
  }

  /* Desktop Layout */
  @media (min-width: 992px) {
    .download-banner {
        flex-direction: row;
        text-align: left;
        justify-content: space-between;
        
        /* ZMENA: Ešte väčší padding pre desktop */
        padding: 4rem 3rem; 
        
        gap: 2rem;
    }
    .text-content {
        flex: 1;
        padding: 0 3rem; /* Viac miesta okolo textu v strede */
        border-left: 1px solid rgba(255,255,255,0.1); 
        margin-left: 2rem; 
    }
    .icon-wrapper { flex-shrink: 0; }
    .action-wrapper { flex-shrink: 0; }
  }

  /* Ikona */
  .icon-wrapper {
      background: transparent;
      border: none;
      cursor: pointer;
      padding: 0;
      transition: transform 0.3s ease, filter 0.3s ease;
      display: flex;
      align-items: center;
      justify-content: center;
  }

  .banner-icon {
    width: 4rem;
    height: 4rem;
    color: var(--fuchsia);
    filter: drop-shadow(0 0 10px rgba(217, 70, 239, 0.4));
    transition: color 0.3s ease, filter 0.3s ease;
  }

  .icon-wrapper:hover .banner-icon {
      color: white;
      filter: drop-shadow(0 0 25px rgba(255, 255, 255, 0.8));
      transform: scale(1.1);
  }

  /* Texty */
  .banner-heading {
    font-size: 1.5rem;
    color: white;
    font-family: 'Space Grotesk', sans-serif;
    margin-bottom: 1rem; /* Väčší odstup pod nadpisom */
  }

  .banner-desc {
    font-size: 1.1rem;
    color: #d1d5db;
    line-height: 1.3; /* Vzdušnejšie riadkovanie */
  }

  .note {
    color: #9ca3af;
    font-style: italic;
    font-size: 0.95rem;
    display: block;
    margin-top: 1rem; /* Väčší odstup pre poznámku */
  }

  /* Tlačidlo */
  .glow-button {
    display: inline-block;
    padding: 1rem 2.5rem;
    border-radius: 4px;
    border: none;
    background: var(--fuchsia);
    color: #000;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    cursor: pointer;
    transition: all 0.3s ease;
    box-shadow: 0 0 20px rgba(217, 70, 239, 0.4);
  }

  .glow-button:hover {
    background: #fff;
    color: #000;
    transform: scale(1.05);
    box-shadow: 0 0 30px rgba(255, 255, 255, 0.7);
  }

  .fade-in-section { opacity: 0; transform: translateY(20px); transition: opacity 0.6s ease-out, transform 0.6s ease-out; }
  .fade-in-section.is-visible { opacity: 1; transform: translateY(0); }
</style>

<script>
  const textBtn = document.getElementById('download-text-btn');
  const iconBtn = document.getElementById('download-icon-btn');

  const handleDownload = () => {
    alert("Momentálne nie je k dispozícii žiadny e-book.");
  };

  textBtn?.addEventListener('click', handleDownload);
  iconBtn?.addEventListener('click', handleDownload);

  const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
          if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
          }
      });
  }, { threshold: 0.1 });

  document.querySelectorAll('.fade-in-section').forEach(el => observer.observe(el));
</script>