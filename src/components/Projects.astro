---

<section id="projects" class="projects-section">
  <div class="container fade-in-section">
    
    <h2 class="section-title neon-text-cyan">Projekty</h2>

    <div id="projects-filters" class="filters-wrapper">
      {categories.map(category => (
        <button 
          class={`filter-btn ${category === 'Všetky' ? 'active' : ''}`}
          data-category={category}
        >
          {category}
        </button>
      ))}
    </div>

    <div id="projects-grid" class="projects-grid">
      {projectsData.map((project) => (
        <article 
            class="project-card" 
            data-category={project.category}
            style="display: none;" 
        >
          <div class="card-inner">
              <div class="image-wrapper">
                <Image 
                    src={project.imageUrl} 
                    alt={project.title} 
                    class="project-img-optimized"
                    width={800}
                    height={400}
                    loading="lazy" 
                    decoding="async"
                />
              </div>
              
              <div class="card-content">
                <h3 class="card-title">{project.title}</h3>
                <p class="card-desc">{project.description}</p>
                
                <div class="tags-wrapper">
                    {project.tags.map(tag => (
                        <span class="tag">{tag}</span>
                    ))}
                </div>

                <div class="links-wrapper">
                    {project.liveUrl && (
                        <a href={project.liveUrl} target="_blank" class="link-btn">Ukážka</a>
                    )}
                    {/* {project.sourceUrl && (
                        <a href={project.sourceUrl} target="_blank" class="link-btn">Zdrojový Kód</a>
                    )} */}
                </div>
              </div>
          </div>
        </article>
      ))}
    </div>

    <div id="empty-state" class="empty-state" style="display: none;">
        <p>V tejto kategórii zatiaľ nie sú žiadne projekty. Postupne budú pridané.</p>
    </div>

    <div class="load-more-wrapper">
        <button id="load-more-btn" class="action-btn neon-button-cyan">
            Zobraziť Viac
        </button>
        <button id="show-less-btn" class="action-btn neon-button-fuchsia" style="display: none;">
            Schovať
        </button>
    </div>

  </div>
</section>

<style>
  /* ZVYŠOK CSS A SKRIPT OSTÁVA NEZMENENÝ (Z tvojho pôvodného kódu) */
  .projects-section { padding: 6rem 1.5rem; position: relative; z-index: 2000; }
  .container { max-width: 1200px; margin: 0 auto; }
  .section-title { text-align: center; font-size: 2.5rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; color: var(--cyan, #22d3ee); margin-bottom: 3rem; }
  .neon-text-cyan { text-shadow: 0 0 10px rgba(34, 211, 238, 0.5), 0 0 20px rgba(34, 211, 238, 0.3); }
  
  .filters-wrapper { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.5rem; margin-bottom: 3rem; }
  .filter-btn { padding: 0.6rem 1.5rem; font-size: 0.95rem; font-weight: 600; border-radius: 99px; border: 1px solid rgba(255, 255, 255, 0.1); background: rgba(255, 255, 255, 0.05); backdrop-filter: blur(5px); color: #d1d5db; cursor: pointer; transition: all 0.3s ease; display: inline-flex; align-items: center; justify-content: center; }
  .filter-btn:hover, .filter-btn.active { background: var(--cyan); border-color: var(--cyan); color: #000; box-shadow: 0 0 20px rgba(34, 211, 238, 0.4); transform: translateY(-2px); }
  @media (min-width: 768px) { .filter-btn { font-size: 1rem; } }

  .projects-grid { display: grid; grid-template-columns: 1fr; gap: 2rem; min-height: 400px; }
  @media (min-width: 768px) { .projects-grid { grid-template-columns: repeat(2, 1fr); } }
  .project-card { animation: fadeUp 0.5s ease-out forwards; }
  @keyframes fadeUp { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }

  
  /* 1. Základný štýl pre MOBILY (Rýchly, bez efektov) */
.card-inner { 
    background-color: rgba(17, 24, 39, 0.95); /* Menej priehľadné, aby bol text čitateľný bez bluru */
    backdrop-filter: none; /* Vypnutý blur = 60fps */
    -webkit-backdrop-filter: none;
    
    border: 1px solid rgba(34, 211, 238, 0.2); 
    border-radius: 0.5rem; 
    overflow: hidden; 
    transition: all 0.5s; 
    height: 100%; 
    display: flex; 
    flex-direction: column; 
    
    /* Hardvérová akcelerácia pre pohyb */
    transform: translateZ(0);
}

/* 2. Efekty zapneme len pre DESKTOP (od 992px vyššie) */
@media (min-width: 992px) {
    .card-inner {
        background-color: rgba(17, 24, 39, 0.6); /* Viac priehľadné */
        backdrop-filter: blur(4px); /* Tu si to môžeme dovoliť */
        -webkit-backdrop-filter: blur(4px);
    }
}

  .card-inner:hover { border-color: rgba(34, 211, 238, 0.8); box-shadow: 0 0 20px rgba(34, 211, 238, 0.4); }
  
  /* Na mobile (1 stĺpec) drž pomer 2/1 = celý náhľad bez orezania
     (thumbnaily sa generujú 800x400, zdrojové screenshoty sú ~2:1);
     pevná výška 14rem by pri širokej karte odsekla vrch a spodok obrázka */
  .image-wrapper { overflow: hidden; aspect-ratio: 2 / 1; }
  @media (min-width: 768px) { .image-wrapper { aspect-ratio: auto; height: 14rem; } }
  /* Pridal som triedu pre image komponent */
  .project-img-optimized { width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s; }
  .card-inner:hover .project-img-optimized { transform: scale(1.05); }

  .card-content { padding: 1.5rem; flex: 1; display: flex; flex-direction: column; }
  .card-title { font-size: 1.5rem; font-weight: 700; color: var(--cyan, #22d3ee); margin-bottom: 0.5rem; }
  .card-desc { color: #d1d5db; margin-bottom: 1rem; flex-grow: 1; }
  .tags-wrapper { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1.5rem; }
  .tag { padding: 0.25rem 0.75rem; background-color: rgba(22, 78, 99, 0.5); color: #67e8f9; font-size: 0.875rem; border-radius: 9999px; }
  .links-wrapper { display: flex; gap: 1rem; }
  .link-btn { color: #e879f9; text-decoration: none; transition: color 0.3s; }
  .link-btn:hover { color: #f0abfc; text-decoration: underline; }
  .empty-state { text-align: center; color: #9ca3af; font-style: italic; font-size: 1.25rem; padding: 4rem 0; }
  .load-more-wrapper { text-align: center; margin-top: 3rem; }
  .action-btn { padding: 1rem 3rem; background: transparent; border: none; font-size: 1rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; cursor: pointer; border-radius: 4px; transition: transform 0.2s, filter 0.2s; }
  .action-btn:hover { transform: scale(1.05); filter: brightness(1.1); }
  .neon-button-cyan { background: linear-gradient(90deg, #0891b2, var(--cyan)); color: #000; box-shadow: 0 0 20px rgba(34, 211, 238, 0.4); }
  .neon-button-fuchsia { background: linear-gradient(90deg, #a21caf, var(--fuchsia)); color: #000; box-shadow: 0 0 20px rgba(217, 70, 239, 0.4); }
  .fade-in-section { opacity: 0; transform: translateY(20px); transition: opacity 0.6s ease-out, transform 0.6s ease-out; }
  .fade-in-section.is-visible { opacity: 1; transform: translateY(0); }
</style>

<script>
  // JAVASCRIPT LOGIKA PRE PROJEKTY
  
  const INITIAL_COUNT = 2; // Koľko kariet sa zobrazí na začiatku
  const LOAD_STEP = 4;     // Koľko kariet sa pridá po kliknutí na "Zobraziť Viac"
  
  let currentCategory = 'Všetky';
  let visibleCount = INITIAL_COUNT;

  // Elementy
  const filterBtns = document.querySelectorAll('#projects-filters .filter-btn');
  const projects = document.querySelectorAll('.project-card');
  const loadMoreBtn = document.getElementById('load-more-btn');
  const showLessBtn = document.getElementById('show-less-btn');
  const emptyState = document.getElementById('empty-state');
  const section = document.getElementById('projects');

  // HLAVNÁ VYROBNO-FILTRAČNÁ FUNKCIA
  function updateProjects() {
    let matchedCount = 0;
    let displayedCount = 0;

    projects.forEach((project) => {
        const card = project as HTMLElement;
        // Orezanie medzier pre istotu (Robustnosť)
        const category = (card.dataset.category || "").trim();
        
        const isMatch = currentCategory === 'Všetky' || category === currentCategory;

        if (isMatch) {
            matchedCount++;
            
            if (displayedCount < visibleCount) {
                // Zobraziť kartu
                card.style.display = 'block';
                // Animácia len ak je to nové zobrazenie
                if (card.style.animation === '' || card.style.display === 'none') {
                    card.style.animation = 'none';
                    card.offsetHeight; /* trigger reflow */
                    card.style.animation = 'fadeUp 0.5s ease-out forwards';
                }
                displayedCount++;
            } else {
                // Skryť kartu (nad limit)
                card.style.display = 'none';
            }
        } else {
            // Skryť, ak nepasuje filter
            card.style.display = 'none';
        }
    });

    // Kontrola prázdneho stavu
    if (emptyState) {
        emptyState.style.display = matchedCount === 0 ? 'block' : 'none';
    }

    // --- LOGIKA TLAČIDIEL ---
    
    // Predvolené skrytie
    if (loadMoreBtn) loadMoreBtn.style.display = 'none';
    if (showLessBtn) showLessBtn.style.display = 'none';

    if (matchedCount > INITIAL_COUNT) {
        if (visibleCount < matchedCount) {
            // Ukázať "Zobraziť Viac"
            if (loadMoreBtn) loadMoreBtn.style.display = 'inline-block';
        } else {
            // Ukázať "Schovať" (všetko je zobrazené)
            if (showLessBtn) showLessBtn.style.display = 'inline-block';
        }
    }
  }

  // --- EVENT LISTENERS ---

  // 1. Kliknutie na filter
  filterBtns.forEach(btn => {
    btn.addEventListener('click', (e) => {
        filterBtns.forEach(b => b.classList.remove('active'));
        
        // Použijeme e.currentTarget, aby sa trieda pridelila vždy tlačidlu, nie textu
        (e.currentTarget as HTMLElement).classList.add('active');
        
        const rawCat = (e.currentTarget as HTMLElement).dataset.category;
        currentCategory = rawCat ? rawCat.trim() : 'Všetky';
        
        visibleCount = INITIAL_COUNT; // Reset na 2
        updateProjects();
    });
  });

  // 2. Tlačidlo: Zobraziť Viac
  loadMoreBtn?.addEventListener('click', () => {
    visibleCount += LOAD_STEP; // Pridaj 4
    updateProjects();
  });

  // 3. Tlačidlo: Schovať
  showLessBtn?.addEventListener('click', () => {
    visibleCount = INITIAL_COUNT; // Reset na 2
    updateProjects();
    section?.scrollIntoView({ behavior: 'smooth' });
  });

  // --- SPUSTENIE A SYNCHRONIZÁCIA ---

  // 1. Natvrdo aktivuj "Všetky" vizuálne na štarte
  filterBtns.forEach(btn => {
      const category = (btn.dataset.category || "").trim();
      if (category === 'Všetky') {
          btn.classList.add('active');
      } else {
          btn.classList.remove('active');
      }
  });

  // 2. Prvé spustenie hlavnej funkcie
  updateProjects();

  // 3. Observer pre fade-in animáciu
  const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
          if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
          }
      });
  }, { threshold: 0.1 });

  document.querySelectorAll('.fade-in-section').forEach(el => observer.observe(el));
</script>