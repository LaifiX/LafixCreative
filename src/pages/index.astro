---
import '../styles/global.css';
import MainLayout from '../layouts/MainLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import Skills from '../components/Skills.astro';
import Projects from '../components/Projects.astro';
import Blog from '../components/Blog.astro';
import Download from '../components/Download.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import Buttons from '../components/MagneticButtons.astro';
import ServicesBanner from '../components/ServicesBanner.astro';
---

<MainLayout 
  title="Peter Beňo | Web Developer & Sales Strategist"
  description="Hľadáte prepojenie technológií a obchodu? Tvorím weby, ktoré predávajú, a zavádzam AI do firemných procesov."
>
    
    <div id="preloader">
        <div class="loader-content">
            <span class="loader-text">INITIALIZING SYSTEM</span>
            <div class="loader-bar"><div class="loader-progress"></div></div>
        </div>
    </div>

    <div class="noise-overlay"></div>
    
    <Header />
    
    <Hero /> 
    
    <main>
        <About /> 
        <Skills />
        <ServicesBanner />
        <Projects />
        <Blog />
        <Download />
        <Contact />
    </main>

    <Footer />
    
    <Buttons />

</MainLayout>

<style>
    /* Noise */
    .noise-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        pointer-events: none; 
        z-index: 9000;
        opacity: 0.02; 
        background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.3' numOctaves='1' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E");
    }

    /* Preloader */
    #preloader {
        position: fixed;
        inset: 0;
        background: #050505;
        z-index: 99999;
        display: flex;
        justify-content: center;
        align-items: center;
        transition: opacity 0.5s ease, visibility 0.5s ease;
    }
    .loader-content {
        text-align: center;
        font-family: monospace;
        color: var(--cyan);
    }
    .loader-text {
        display: block;
        margin-bottom: 10px;
        letter-spacing: 0.2em;
        animation: blink 1s infinite;
    }
    .loader-bar {
        width: 200px;
        height: 2px;
        background: rgba(255,255,255,0.1);
        overflow: hidden;
    }
    .loader-progress {
        width: 0%;
        height: 100%;
        background: var(--cyan);
        animation: load 1.5s ease-in-out forwards;
        box-shadow: 0 0 10px var(--cyan);
    }
    @keyframes load { 0% { width: 0%; } 100% { width: 100%; } }
    @keyframes blink { 50% { opacity: 0.5; } }
    
    /* Skrytie po načítaní */
    body.loaded #preloader {
        opacity: 0;
        visibility: hidden;
    }
</style>

<script>
    window.addEventListener('load', () => {
        setTimeout(() => {
            document.body.classList.add('loaded');
        }, 1500); // Čas na efekt (1.5s)
    });
</script>